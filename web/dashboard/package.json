{
  "name": "vecta-kms-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.js,.mjs,.cjs --max-warnings=0",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.mjs,.cjs --fix",
    "check:component-size": "node scripts/check-component-size.mjs",
    "build": "npm run generate:rest-catalog && npm run generate:openapi && npm run typecheck && vite build",
    "build:docker": "npm run generate:rest-catalog && npm run generate:openapi && npm run typecheck && vite build",
    "preview": "vite preview",
    "generate:rest-catalog": "node scripts/generate-rest-catalog.mjs",
    "generate:openapi": "node scripts/generate-openapi.mjs",
    "validate:openapi": "node scripts/validate-openapi.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:smoke": "playwright test",
    "test:smoke:headed": "playwright test --headed",
    "test:smoke:debug": "playwright test --debug"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query": "5.103.2",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "yaml": "2.9.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.6.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.12.0",
    "postcss": "8.5.28",
    "swagger-ui-dist": "5.33.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "overrides": {
    "flatted": "^3.4.2"
  }
}
