# Default local compose settings.
# This profile list is derived from infra/deployment/deployment.yaml.
COMPOSE_PROJECT_NAME=vecta-kms-beta-2

# ---- Database credentials -----------------------------------------------
# REQUIRED: set a strong password before first run.
# Never commit a real password here; use a secrets manager in production.
# WARNING: change this to a strong secret before first production run.
# If a postgres-data volume already exists, it was initialized with the password
# it was first started with — update both the volume and this value together.
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres
POSTGRES_DB=vecta
# -------------------------------------------------------------------------
#
# Development-only bootstrap values for local compose runs.
# Replace these before using the stack outside a local/dev context.
NATS_AUTH_TOKEN=vecta-dev-nats-token-2026
WORKLOAD_IDENTITY_SHARED_SECRET=kbeta-workload-shared-secret-2026
AUTH_BOOTSTRAP_ADMIN_PASSWORD=VectaAdmin@2026
AUTH_BOOTSTRAP_CLI_PASSWORD=VectaCLI@2026
SOFTWARE_VAULT_PASSPHRASE=vecta-dev-passphrase
COMPOSE_PROFILES=secrets,certs,governance,cloud_byok,hyok_proxy,kmip_server,qkd_interface,qrng_generator,ekm_database,payment_crypto,autokey_provisioning,artifact_signing,key_access_justifications,workload_identity,confidential_compute,compliance_dashboard,sbom_cbom,reporting_alerting,posture_management,ai_llm,ai_gateway,pqc_migration,crypto_discovery,mpc_engine,data_protection,hsm_software,event_streaming,service_discovery,distributed_cache
CBOM_SCHEDULE_TENANTS=root
# Certificate private-key protection (CRWK sealed outside DB)
# CERTS_STORAGE_MODE=db_encrypted
# CERTS_ROOT_KEY_MODE=software
# CERTS_CRWK_SEALED_PATH=/var/lib/vecta/certs/crwk.sealed
# CERTS_CRWK_PASSPHRASE_FILE=/var/lib/vecta/certs/bootstrap.passphrase
# Runtime cert materializer (writes only to in-memory runtime-certs tmpfs volume)
# CERTS_RUNTIME_MATERIALIZER_ENABLED=true
# CERTS_RUNTIME_MATERIALIZER_INTERVAL=5m
# CERTS_RUNTIME_MATERIALIZER_RENEW_BEFORE=24h
INTERNAL_API_TOKEN=874156b08de5a6a98153e9f591babb97a75ffe2c4d526058315cadfac7d0cabd
AI_GATEWAY_JWT_PUBLIC_KEY_
CONFIDENTIAL_JWT_PUBLIC_KEY_
JWT_PUBLIC_KEY_
