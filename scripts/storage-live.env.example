# Settings for scripts/verify-storage-live.sh. Copy to .storage-live.env
# (ignored by git), chmod 600, and fill in only the services to check.
# Each needs a credential that can LIST and READ the bucket, nothing more.

# --- Amazon S3, or a service that speaks its API ---------------------------
# Endpoint: https://s3.<region>.amazonaws.com for AWS.
VECTA_TEST_S3_ENDPOINT=
VECTA_TEST_S3_REGION=
VECTA_TEST_S3_BUCKET=
VECTA_TEST_S3_PREFIX=
VECTA_TEST_S3_ACCESS_KEY=
VECTA_TEST_S3_SECRET_KEY=
# Role assumption (AWS): the key above needs only sts:AssumeRole on this
# role; the role needs s3:ListBucket and s3:GetObject on the bucket.
VECTA_TEST_S3_ROLE_ARN=
VECTA_TEST_S3_EXTERNAL_ID=
# Only for a service other than AWS that implements STS (MinIO, Ceph).
VECTA_TEST_S3_STS_URL=

# --- Azure Blob Storage ----------------------------------------------------
# Endpoint: https://<account>.blob.core.windows.net
VECTA_TEST_AZURE_ENDPOINT=
VECTA_TEST_AZURE_CONTAINER=
# One or more of the three credentials; each is checked on its own.
VECTA_TEST_AZURE_SAS=
VECTA_TEST_AZURE_TENANT_ID=
VECTA_TEST_AZURE_CLIENT_ID=
VECTA_TEST_AZURE_CLIENT_SECRET=
VECTA_TEST_AZURE_ACCOUNT_NAME=
VECTA_TEST_AZURE_ACCOUNT_KEY=

# --- Google Cloud Storage (its own API) ------------------------------------
VECTA_TEST_GCS_BUCKET=
VECTA_TEST_GCS_PREFIX=
# Path of a service account's JSON key file (Storage Object Viewer on the
# bucket). Leave empty to read a public bucket with no credential.
VECTA_TEST_GCS_SERVICE_ACCOUNT_FILE=

# --- Options ---------------------------------------------------------------
# Least number of assets each scan must find (0: any).
VECTA_TEST_STORAGE_MIN_ASSETS=
# 1 to also look into objects whose names say nothing.
VECTA_TEST_STORAGE_DEEP=
# A PEM file to trust, for a private endpoint with its own CA. Leave empty
# for public cloud endpoints.
VECTA_TEST_STORAGE_CA=
