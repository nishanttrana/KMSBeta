# Settings for scripts/verify-byok-live.sh. Copy to .byok-live.env (ignored
# by git), chmod 600, and fill in only the clouds to check.
#
# The run CREATES A REAL KEY in each cloud and schedules it for deletion at
# the end. Use a test account. What each credential must be allowed to do,
# and what the cloud keeps afterwards, is in
# docs/SECURITY/CLOUD_BYOK_LIVE_VERIFICATION.md.

# --- AWS KMS ---------------------------------------------------------------
VECTA_TEST_BYOK_AWS_ACCESS_KEY=
VECTA_TEST_BYOK_AWS_SECRET_KEY=
VECTA_TEST_BYOK_AWS_REGION=
# Optional: temporary credentials, or a role to assume with the key above.
VECTA_TEST_BYOK_AWS_SESSION_TOKEN=
VECTA_TEST_BYOK_AWS_ROLE_ARN=
VECTA_TEST_BYOK_AWS_EXTERNAL_ID=
# Optional: a VPC endpoint for KMS. With VECTA_TEST_BYOK_AWS_EMULATOR=1 the
# endpoint is an emulator such as LocalStack, not AWS: the altered
# credential, the renewal and the restore are left out, and nothing it
# passes counts as verified on AWS.
VECTA_TEST_BYOK_AWS_ENDPOINT=
VECTA_TEST_BYOK_AWS_EMULATOR=

# --- Google Cloud KMS ------------------------------------------------------
# The path of the service account's JSON key file (keep it chmod 600).
VECTA_TEST_BYOK_GCP_SERVICE_ACCOUNT_FILE=
VECTA_TEST_BYOK_GCP_PROJECT=
# A location with HSM protection, for example europe-west3.
VECTA_TEST_BYOK_GCP_LOCATION=
# Created if it does not exist. Google never deletes a key ring.
VECTA_TEST_BYOK_GCP_KEY_RING=

# --- Azure -----------------------------------------------------------------
# One app registration, and either or both of:
#   a Managed HSM, https://<name>.managedhsm.azure.net (an AES-256 key);
#   a Key Vault Premium, https://<name>.vault.azure.net, which takes no AES
#   key (an RSA-3072 private key is imported, and signs there).
VECTA_TEST_BYOK_AZURE_VAULT_URL=
VECTA_TEST_BYOK_AZURE_KV_VAULT_URL=
VECTA_TEST_BYOK_AZURE_TENANT_ID=
VECTA_TEST_BYOK_AZURE_CLIENT_ID=
VECTA_TEST_BYOK_AZURE_CLIENT_SECRET=

# --- OCI Vault -------------------------------------------------------------
VECTA_TEST_BYOK_OCI_TENANCY=
VECTA_TEST_BYOK_OCI_USER=
VECTA_TEST_BYOK_OCI_FINGERPRINT=
# The path of the API signing key (PEM, no passphrase; keep it chmod 600).
VECTA_TEST_BYOK_OCI_PRIVATE_KEY_FILE=
VECTA_TEST_BYOK_OCI_REGION=
VECTA_TEST_BYOK_OCI_COMPARTMENT=
# The vault's two endpoints, from its details page.
VECTA_TEST_BYOK_OCI_MANAGEMENT_ENDPOINT=
VECTA_TEST_BYOK_OCI_CRYPTO_ENDPOINT=

# --- Alibaba Cloud KMS -----------------------------------------------------
VECTA_TEST_BYOK_ALIBABA_ACCESS_KEY=
VECTA_TEST_BYOK_ALIBABA_SECRET_KEY=
VECTA_TEST_BYOK_ALIBABA_REGION=

# --- Salesforce Shield -----------------------------------------------------
# IMPORT ONLY, and it cannot be undone: the upload becomes the org's active
# tenant secret of its type and Shield deletes none. Shield takes one upload
# a day (every four hours in a sandbox). Use a sandbox or a developer org.
VECTA_TEST_BYOK_SALESFORCE_INSTANCE_URL=
VECTA_TEST_BYOK_SALESFORCE_CLIENT_ID=
VECTA_TEST_BYOK_SALESFORCE_CLIENT_SECRET=
VECTA_TEST_BYOK_SALESFORCE_USERNAME=
VECTA_TEST_BYOK_SALESFORCE_PASSWORD=
VECTA_TEST_BYOK_SALESFORCE_SECURITY_TOKEN=
# The BYOK-compatible certificate made in Setup: its unique name, and the
# path of its PEM file (public, as downloaded).
VECTA_TEST_BYOK_SALESFORCE_CERTIFICATE_NAME=
VECTA_TEST_BYOK_SALESFORCE_CERTIFICATE_FILE=
