# Vecta KMS - Environment Variables
# Copy this file to .env and fill in real values before running docker-compose.
#
# Every secret below is EMPTY on purpose (docs/SECURITY/SECURE_DEFAULTS.md):
# compose refuses to start until it is set, and services reject placeholder
# values such as "your-..." or "change-me". ./deploy-local.sh and install.sh
# generate all of them for you. To fill them by hand use: openssl rand -hex 32

# Release version — tags built images (vecta/<svc>:$VECTA_VERSION) and is
# stamped into services as BUILD_VERSION. Keep in sync with the VERSION file.
VECTA_VERSION=1.2.0-beta

# Authentication bootstrap. Leave the admin password empty to seed admin/changeit
# (a password change is forced on first login). The CLI password must meet the
# password policy (>= 12 chars, upper + lower + digit + special).
AUTH_BOOTSTRAP_ADMIN_PASSWORD=
AUTH_BOOTSTRAP_CLI_PASSWORD=

# Workload identity (required). openssl rand -hex 32
WORKLOAD_IDENTITY_SHARED_SECRET=

# NATS auth token for the event-streaming bus (required). openssl rand -hex 24
NATS_AUTH_TOKEN=

# Valkey (cache) password, on top of mTLS (required). openssl rand -hex 24
VALKEY_PASSWORD=

# Passphrase sealing the certs root wrapping key (optional). Leave empty: the
# installer generates one inside the certs key volume. If set, at least 32
# random characters (openssl rand -hex 32); certs refuses a weak or public one.
CERTS_CRWK_BOOTSTRAP_PASSPHRASE=

# Service-to-service bearer used by the reconciler for privileged calls
# to keycore / kmip / policy / audit. Validated by pkg/internalauth.
# Required. openssl rand -hex 32
INTERNAL_API_TOKEN=

# Shared secret every internal service derives its API key from (service JWTs).
# Required, >= 32 chars; auth refuses to start on a weak or placeholder value.
# openssl rand -hex 32
INTERNAL_SERVICE_BOOTSTRAP_SECRET=

# JWT public key for every tenant-scoped service (policy, audit,
# secrets, certs, backup, keyaccess, signing, compliance, reporting,
# dam, ai-gateway, confidential, …). Each service refuses to start
# without it. The B64 form is base64-encoded PEM; <PREFIX>_JWT_PUBLIC_KEY_*
# can override per-service for selective rollout. ./deploy-local.sh derives it
# from the auth signing key automatically.
JWT_PUBLIC_KEY_B64=

# FIPS 140-3 runtime mode for the FIRST start. After that, change it in the KMS
# UI (System Administration > Runtime Crypto); the UI setting wins
# (docs/SECURITY/FIPS.md):
#   on    (default) certified Go Cryptographic Module in FIPS mode
#   only  strict: every non-approved algorithm is refused by the Go runtime
#   off   FIPS mode disabled
VECTA_FIPS_MODE=on

# Database (required). openssl rand -hex 24
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=vecta

# hsm-integration SSH endpoint (library uploads). Public keys only, ";"-separated;
# when set, password login is off. Bind address of port 2222 (default loopback).
HSM_INTEGRATION_SSH_AUTHORIZED_KEYS=
HSM_INTEGRATION_SSH_BIND=
