# Vecta KMS - Environment Variables
# Copy this file to .env and fill in real values before running docker-compose.

# Authentication bootstrap secrets (required)
AUTH_BOOTSTRAP_ADMIN_PASSWORD=your-secure-admin-password
AUTH_BOOTSTRAP_CLI_PASSWORD=your-secure-cli-password

# Workload identity (required)
WORKLOAD_IDENTITY_SHARED_SECRET=your-workload-identity-secret

# Service-to-service bearer used by the reconciler for privileged calls
# to keycore / kmip / policy / audit. Validated by pkg/internalauth.
# Generate with: openssl rand -hex 32
INTERNAL_API_TOKEN=your-internal-api-token

# JWT public keys for tenant-aware services. Both ai-gateway and
# confidential refuse to start without a public key configured
# (security review vulns #1 + #2, May 2026). The B64 form is base64-
# encoded PEM; the PEM form is the raw PEM. Use the same auth-service
# signing key across services so a single JWT validates everywhere.
AI_GATEWAY_JWT_PUBLIC_KEY_B64=your-jwt-public-key-base64
CONFIDENTIAL_JWT_PUBLIC_KEY_B64=your-jwt-public-key-base64

# Software vault passphrase (required)
SOFTWARE_VAULT_PASSPHRASE=your-vault-passphrase

# HSM backup wrap secret (required for HSM-bound backups)
BACKUP_HSM_WRAP_SECRET=your-hsm-wrap-secret

# Database
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your-db-password
# POSTGRES_DB=vecta
